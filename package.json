{
  "name": "amp22",
  "productName": "AMP22",
  "version": "1.0.0",
  "description": "Watch and analyze NFL All-22 film: synced sideline + end zone angles, play-by-play navigation, frame stepping.",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "apulianas",
  "scripts": {
    "prestart": "npm run build:ai",
    "start": "electron .",
    "build:ai": "node scripts/build-analytics-ai.js",
    "test": "node --test",
    "analyze": "node scripts/analyze.js",
    "build:icons": "node scripts/build-icons.js",
    "build:extension": "node scripts/build-extension.js",
    "build:extension-icons": "electron scripts/build-extension-icons.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "@derhuerst/ffprobe-static@5.3.0": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "beforePack": "./scripts/build-analytics-ai.js",
    "appId": "com.apulianas.a22filmtool",
    "productName": "AMP22",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@derhuerst/ffprobe-static/**"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "build/native",
          "to": "native",
          "filter": [
            "amp22-foundation-models"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/AMP22.icon",
      "category": "public.app-category.sports",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "strictVerify": true,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

{
  "name": "a22-film-tool",
  "productName": "A22 Film Tool",
  "version": "0.1.0",
  "description": "Watch and analyze NFL All-22 film: synced sideline + end zone angles, play-by-play navigation, frame stepping.",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "apulianas",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "analyze": "node scripts/analyze.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.apulianas.a22filmtool",
    "productName": "A22 Film Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

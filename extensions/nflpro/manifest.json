{
  "manifest_version": 3,
  "name": "AMP22 NFL Pro Participation",
  "version": "0.2.2",
  "description": "Capture every NFL Pro game play automatically and download player participation as an AMP22 CSV.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://pro.nfl.com/film/*"],
    "js": ["participation.js", "collector.js", "content.js"]
  }]
}
